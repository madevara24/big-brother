# Copy this file to .env in the same directory as the vpswatch binary
# (see install.sh / README.md) and fill in the two secret URLs below.
# Never commit the real .env.

# Tick interval, in seconds. The systemd timer also fires every 1 minute
# (see systemd/vpswatch.timer) -- keep this in sync if you change the timer.
VPSWATCH_TICK=60

# Consecutive bad checks required before an alert fires (5 checks x 60s
# tick = 5 minutes of sustained badness before Discord hears about it).
VPSWATCH_DEBOUNCE=5

# healthchecks.io ping URL -- pinged every tick, unconditionally, whether
# or not any metric is over threshold. Set the check's grace period in
# healthchecks.io to a few times VPSWATCH_TICK.
VPSWATCH_HEALTHCHECKS_PING_URL=

# Discord webhook URL that receives alerts, recoveries, the hourly digest,
# and the one-time setup message.
VPSWATCH_DISCORD_WEBHOOK_URL=

# --- Alert thresholds -------------------------------------------------

# CPU: 1-minute load average (from /proc/loadavg). Alert when load1 >= this.
VPSWATCH_CPU_LOAD_ALERT=6.0

# Memory: MemAvailable (from /proc/meminfo). Alert when available memory
# drops to or below this many MB.
VPSWATCH_MEM_AVAIL_ALERT_MB=1024

# Swap: used swap (SwapTotal - SwapFree, from /proc/meminfo). Alert when
# swap used reaches or exceeds this many MB.
VPSWATCH_SWAP_USED_ALERT_MB=1024

# Disk: used % of each real mount (via statfs), except /boot -- see below.
# Alert when used% reaches or exceeds this.
VPSWATCH_DISK_USED_ALERT_PCT=90

# Disk: /boot is usually much smaller than the root filesystem and fills
# up differently (kernel/initrd churn), so it gets its own threshold.
VPSWATCH_BOOT_USED_ALERT_PCT=80

# I/O wait %, delta over the tick (from /proc/stat). Alert when it reaches
# or exceeds this.
VPSWATCH_IOWAIT_ALERT_PCT=25

# --- Warn tier (off by default) ----------------------------------------

# A lower-severity tier below "alert" -- messages once when crossed, does
# not repeat, and resets once the metric's back to normal so a later,
# separate incident can warn again. Off by default; these threshold
# values are placeholders for v1.
VPSWATCH_WARN_ENABLED=false

VPSWATCH_CPU_LOAD_WARN=4.0
VPSWATCH_MEM_AVAIL_WARN_MB=2048
VPSWATCH_SWAP_USED_WARN_MB=512
VPSWATCH_DISK_USED_WARN_PCT=80
VPSWATCH_BOOT_USED_WARN_PCT=70
VPSWATCH_IOWAIT_WARN_PCT=15

# --- Digest / sample retention (not in the original spec, but needed to
# test the hourly digest without waiting an hour -- see README) --------

# How often the Discord digest (min/avg/max/p95 per metric) is sent.
VPSWATCH_DIGEST_INTERVAL_MINUTES=60

# How long the on-disk rolling sample log keeps ticks around for the
# digest to summarize. Must be comfortably larger than (not just >=)
# VPSWATCH_DIGEST_INTERVAL_MINUTES: pruning runs before the digest reads
# on each tick, so if retention only just equals the interval, the
# earliest samples in the digest's window get pruned right before the
# digest reads them.
VPSWATCH_SAMPLE_RETENTION_MINUTES=75
